# IP·Power 설정 — 뉴스는 전부 선택(무키), 특허는 EPO OPS 키가 필요

# ── 뉴스(Google 뉴스 RSS, 매일) — 키 불필요 ─────────────────────
# 수집 모드: auto(차단시 mock 폴백) | on(강제 mock) | off(강제 라이브, Actions용)
NEWS_MOCK=auto
# 사이트 생성 폴더 (기본 site/)
# NEWS_SITE_DIR=site
# 이전 아카이브 폴더 — Actions에서 gh-pages 체크아웃 경로로 주입됨 (로컬은 비움)
# NEWS_PREV_DIR=
# 카테고리별 최대 기사 수 (기본 14)
# NEWS_PER_CATEGORY=14
# 유사 기사(같은 사건·다른 매체) 제거 임계값 0~1 (기본 0.55, 높을수록 관대)
# 수집 단계와 아카이브 병합(날짜 간 중복) 양쪽에 같은 값이 쓰인다.
# NEWS_DEDUP_SIM=0.55

# ── 특허(EPO OPS 공식 API, 주간) ────────────────────────────────
# ★ 키 필요: developers.epo.org 에서 앱 등록 후 발급.
#   GitHub Actions 에서는 저장소 Secret 으로 등록한다(OPS_KEY / OPS_SECRET).
# OPS_KEY=
# OPS_SECRET=
# 수집 모드: auto | on(강제 mock) | off(강제 라이브, Actions용). 미설정 시 NEWS_MOCK 값을 따름
PATENT_MOCK=auto
# 출원인당 최대 수집 건수 (기본 50)
# PATENT_PER_APPLICANT=50
# 최근 며칠 공개분을 조회할지 (기본 90)
# PATENT_LOOKBACK_DAYS=90
# OPS 요청 간 지연(초, 기본 0.4)
# PATENT_REQ_DELAY=0.4
# 출원인×공개 특허청 정확 집계(랭킹용). 매일 일부만 회전 갱신 → stats.json 에 병합 누적.
# off 로 끄거나, 하루에 처리할 출원인 수를 조절(기본 8곳 → 31곳을 4일에 한 바퀴).
# PATENT_OFFICE_COUNTS=on
# PATENT_OFFICE_BATCH=8
# 주요 출원인 목록·분야 CPC 는 patent_config.py 의 APPLICANTS / CATEGORIES 에서 편집
